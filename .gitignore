# ModMind 工具状态：会话、快照、请求证据、构建缓存、测试实例
.modmind/

# ModMind 每轮自动生成的 AI 记录（含对话正文，不进公开仓库）
docs/last-ai-change.json
docs/last-ai-response.txt
# 同一规则要覆盖模块子目录，否则 modules/*/docs 下的会漏进公开仓库
**/last-ai-change.json
**/last-ai-response.txt

# 第三方模组 jar：靠 modmind.pack.json 清单重下，不入库
mods/*.jar
mods/*.jar.disabled

# 构建与运行派生物
build/
out/
runs/
run/
logs/
crash-reports/
saves/
screenshots/
*.log

# 本地编辑器 / 系统文件
.idea/
.vscode/
*.iml
Thumbs.db
desktop.ini
.DS_Store

# 临时目录
tmp/
temp/
# 模块级研究临时目录（下载的源码 / 反编译产物，几十 MB，靠文档里的链接重取）
research-tmp/

# 协同内核本地状态（脚本与清单入库，锁与流水不入库）
.agents/claim/
.agents/journal.jsonl
# 技能副本是 E:\_ai 母本的拷贝，靠 skills.selected.json 重建，不入库
.agents/skills/
# 内核脚本的临时备份
.agents/*.bak-*
*.bak-*

# worktree 隔离目录（wt.ps1 建）
.wt/

# 模块编译用的第三方 jar（Create / Flywheel / Ponder / Registrate，共约 20MB）
# 靠 build.gradle 里的坐标重下，不入库
modules/*/libs/*.jar
